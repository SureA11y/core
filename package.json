{
  "name": "a11y-core",
  "version": "1.1.0",
  "description": "Lightweight DOM rules accessibility core with modular rules.",
  "main": "src/index.js",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-core.js",
    "test": "npm run build && node --test \"tests/**/*.test.js\"",
    "coverage": "node scripts/generate-wcag-coverage.js",
    "coverage:strict": "node scripts/generate-wcag-coverage.js --strictFacets",
    "validate:automatic-rules": "node scripts/validate-all-rules.js src/rules/automatic",
    "validate:manual-rules": "node scripts/validate-all-rules.js src/rules/manual"
  },
  "devDependencies": {
    "jsdom": "^27.4.0"
  }
}
