{
  "name": "@surea11y/core",
  "version": "1.10.0",
  "description": "Deterministic WCAG 2.2 accessibility engine that tells you what it can't tell you. Zero dependencies.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag21",
    "wcag22",
    "accessibility-testing",
    "a11y-testing",
    "audit",
    "aria",
    "contrast",
    "sarif",
    "junit",
    "zero-dependencies",
    "jsdom",
    "playwright",
    "puppeteer",
    "selenium",
    "cypress",
    "webdriverio",
    "jest",
    "vitest"
  ],
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./baseline": "./src/baseline.js",
    "./report": "./src/report.js",
    "./sarif": "./src/sarif.js",
    "./junit": "./src/junit.js",
    "./earl": "./src/earl.js",
    "./en301549": "./src/en301549.js",
    "./wcag": "./src/wcag.js",
    "./browser": "./surea11y.browser.js",
    "./i18n/*": "./surea11y.i18n.*.js",
    "./package.json": "./package.json"
  },
  "author": "Jorge Rumoroso",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SureA11y/core.git"
  },
  "homepage": "https://surea11y.dev/",
  "bugs": {
    "url": "https://github.com/SureA11y/core/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "src/core.js",
    "src/baseline.js",
    "src/scan-result.js",
    "src/report.js",
    "src/i18n-coverage.js",
    "src/i18n-same-as-english.json",
    "src/sarif.js",
    "src/junit.js",
    "src/earl.js",
    "src/en301549.js",
    "src/coverage/en301549-map.js",
    "src/coverage/standards.js",
    "src/wcag.js",
    "src/profile-kit.js",
    "src/coverage/wcag-facets.js",
    "src/coverage/wcag-version-map.js",
    "profiles/index.js",
    "profiles/*/*.js",
    "profiles/*/rules/**/*.js",
    "src/checks/**/*.js",
    "surea11y.browser.js",
    "surea11y.i18n.*.js",
    "docs/**/*.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!docs/RULE_TEMPLATE.md",
    "!docs/RULE_TEST_TEMPLATE.md",
    "!docs/RULE_TEST_AUTHORING.md",
    "!docs/TEST_OUTCOME_STABILITY.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"profiles/**/*.js\" \"eslint.config.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"profiles/**/*.js\" \"eslint.config.js\"",
    "build": "node scripts/build-core.js && node scripts/build-browser.js",
    "pretest": "playwright install chromium",
    "test": "npm run lint && npm run format:check && npm run build && npm run validate:rules && node scripts/run-tests.js",
    "test:coverage": "npm run build && node scripts/run-tests.js --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-include=profiles/**/*.js",
    "test:contrast-helpers": "node tests/contrast-helpers.test.js",
    "helpers-perf-bench": "node --expose-gc scripts/dom-helpers-perf-bench.js",
    "engine-perf-bench": "node --expose-gc scripts/engine-perf-bench.js  --profileRules=true --iters=25 --top=15",
    "engine-perf-bench-transparent": "node --expose-gc scripts/engine-perf-bench.js --profileRules=true --top=15 --iters=25 --generated=contrastTransparent",
    "engine-perf-bench-opaque": "node --expose-gc scripts/engine-perf-bench.js --profileRules=true --top=15 --iters=25 --generated=contrastOpaque",
    "test:typography-helpers": "node tests/contrast-typography.test.js",
    "coverage": "node scripts/generate-wcag-coverage.js",
    "coverage:strict": "node scripts/generate-wcag-coverage.js --strictFacets",
    "coverage:check": "node scripts/generate-wcag-coverage.js --check",
    "finding-ids": "npm run build && node scripts/generate-finding-ids.js",
    "finding-ids:release": "node scripts/freeze-finding-ids.js",
    "fixtures:index": "node scripts/generate-fixture-index.js",
    "fixtures:check": "node scripts/generate-fixture-index.js --check",
    "fixtures:markers": "npm run build && node scripts/generate-fixture-markers.js",
    "fixtures:markers:check": "npm run build && node scripts/generate-fixture-markers.js --check",
    "docs:rule-catalog": "npm run build && node scripts/generate-rule-catalog.js",
    "docs:rule-catalog:check": "npm run build && node scripts/generate-rule-catalog.js --check",
    "rule-examples:coverage": "npm run build && node scripts/generate-rule-examples-coverage.js",
    "rule-examples:coverage:check": "npm run build && node scripts/generate-rule-examples-coverage.js --check",
    "rule-examples:outcomes": "npm run build && node scripts/generate-rule-examples-outcomes.js",
    "rule-examples:outcomes:check": "npm run build && node scripts/generate-rule-examples-outcomes.js --check",
    "docs:rule-review": "npm run build && node scripts/generate-rule-review.js",
    "validate:automatic-rules": "npm run build && node scripts/validate-all-rules.js src/checks/automatic profiles/*/rules/automatic",
    "validate:manual-rules": "npm run build && node scripts/validate-all-rules.js src/checks/manual profiles/*/rules/manual",
    "validate:rules": "npm run build && node scripts/validate-all-rules.js",
    "i18n:new": "node scripts/i18n-scaffold.js",
    "profile:new": "node scripts/profile-new.js",
    "i18n:sync": "node scripts/i18n-sync.js",
    "i18n:check": "node scripts/i18n-sync.js --check",
    "i18n:report": "node scripts/i18n-report.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "aria-query": "^5.3.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "language-subtag-registry": "^0.4.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
