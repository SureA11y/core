{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a11ycore.dev/schemas/policy-contract.schema.json",
  "title": "PolicyContract",
  "description": "Defines the enforcement policy for rule outcomes and confidence handling (v1).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier for the policy contract."
    },
    "allowedOutcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["fail", "pass", "cantTell", "notApplicable"]
      },
      "description": "Allowed normalized outcomes for rules."
    },
    "allowedConfidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["high", "medium", "low"]
      },
      "description": "Allowed confidence levels for rule results."
    },
    "coerceManualFailToCantTell": {
      "type": "boolean",
      "description": "Whether manual rules are prevented from producing a fail outcome (coerced to cantTell)."
    }
  },
  "required": ["id", "allowedOutcomes", "allowedConfidence", "coerceManualFailToCantTell"]
}